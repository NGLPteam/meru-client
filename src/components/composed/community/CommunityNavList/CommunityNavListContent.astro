---
import { useFragment, type FragmentType } from "@/lib/api/gql";
import { Link, NamedLink } from "@/components/atomic";
import IconFactory from "@/components/factories/IconFactory";
import NavMenuLink from "@/components/atomic/links/NavMenuLink";
import NavDropdown from "@/components/composed/entity/EntityNavBar/EntityNavList/NavDropdown.astro";
import { communityNavListContentFragment } from "./graphql";
import accordionStyles from "./Accordion.module.css";

interface Props {
  condensed?: boolean;
  mobile?: boolean;
  data: FragmentType<typeof communityNavListContentFragment>;
  pageSlug?: string;
}

const { condensed, mobile, data, pageSlug } = Astro.props;
const { t } = Astro.locals;

const community = useFragment(communityNavListContentFragment, data);

const linkClassName = condensed ? "t-label-sm" : "t-label-lg";

const orderings = community.orderings?.nodes?.filter((o) => !!o.count) || [];
const pages = community.pages?.nodes;

const orderingItems = orderings.map((o) => ({
  href: `/communities/${community.slug}/browse/${o.identifier}`,
  label: `${o.name} (${o.count})`,
}));
---

{
  community && community.slug && (
    <>
      {!!orderings.length &&
        (mobile ? (
          <li class="t-capitalize">
            <details>
              <summary class={accordionStyles.summary}>
                <span>{t("nav.explore")}</span>
                <IconFactory
                  icon="chevronDown"
                  role="presentation"
                  data-closed
                />
                <IconFactory icon="chevronUp" role="presentation" data-open />
              </summary>
              <ul class={accordionStyles.list}>
                {orderingItems.map(({ href, label }) => (
                  <li class={accordionStyles.item}>
                    <NamedLink href={href}>
                      <Link as="span">{label}</Link>
                    </NamedLink>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        ) : (
          <NavDropdown
            label="nav.explore"
            disclosureComponent="NavMenuLink"
            disclosureClassName={linkClassName}
            items={orderingItems}
          />
        ))}
      {!!pages?.length &&
        pages.map(({ slug, title }) => (
          <li>
            <NamedLink
              href={`/communities/${community.slug}/page/${slug}`}
              aria-current={pageSlug === slug ? "page" : undefined}
            >
              <NavMenuLink as="span" className={linkClassName}>
                {title}
              </NavMenuLink>
            </NamedLink>
          </li>
        ))}
    </>
  )
}
