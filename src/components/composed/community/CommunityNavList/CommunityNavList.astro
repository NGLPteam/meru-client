---
import { useFragment, type FragmentType } from "@/lib/api/gql";
import CommunityNavListContent from "./CommunityNavListContent.astro";
import { fragment } from "./CommunityNavList";
import styles from "./CommunityNavlist.module.css";

interface Props {
  condensed?: boolean;
  data?: FragmentType<typeof fragment> | null;
  pageSlug?: string;
}

const { condensed, data, pageSlug } = Astro.props;

const community = useFragment(fragment, data);
---

<ul
  class:list={[styles.list, { [styles["list--condensed"]]: condensed }]}
  data-condensed={condensed}
>
  {
    community && (
      <CommunityNavListContent
        data={community}
        condensed={condensed}
        pageSlug={pageSlug}
      />
    )
  }
</ul>
