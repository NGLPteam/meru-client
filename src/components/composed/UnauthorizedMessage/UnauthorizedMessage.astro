---
import Button from "@/components/atomic/Button";

interface Props {
  reason?: string;
  entity?: string;
}

const { reason, entity } = Astro.props;
const { t } = Astro.locals;

const messages = {
  unauthenticated: {
    heading: "messages.unauthorized",
    body: "messages.unauthorized_body",
  },
  forbidden: {
    heading: "messages.forbidden",
    body: "messages.forbidden_body",
  },
};

const keys =
  reason && reason in messages
    ? messages[reason as keyof typeof messages]
    : messages.forbidden;

const entityLabel = entity ? t(`glossary.${entity}`) : t("common.record");
---

<div
  class="l-container-wide l-flex l-flex--align-center"
  style="min-height: 40vh; justify-content: center;"
>
  <div class="t-rte t-align-center">
    <h2 class="t-h3">{t(keys.heading, { entity: entityLabel })}</h2>
    <Fragment set:html={t(keys.body, { entity: entityLabel })} />
    <Button size="sm" as="a" href="/">
      {t("nav.home")}
    </Button>
  </div>
</div>
