---
// Per-viewer account nav as an Astro `server:defer` island. The cached page HTML
// carries only the placeholder + anonymous `slot="fallback"`; the browser fetches
// the real (authed-or-anonymous) menu out-of-band from /_server-islands/AccountNav.
// This is what lets the surrounding page be cached for everyone without baking one
// viewer's identity into the URL-keyed response cache.
import getViewer from "~/lib/auth/viewer";
import { isDraftModeEnabled } from "~/lib/request/draftMode";
import AccountMenu from "./AccountMenu.astro";

interface Props {
  mobile?: boolean;
  condensed?: boolean;
}

const { mobile, condensed } = Astro.props;

// Resolved per-request. getViewer is memoized on Astro.locals (anonymous
// short-circuits with no network); the session comes from attachUserAndSession,
// which runs on the server-island request too.
const viewer = await getViewer(Astro);
const isPreview = isDraftModeEnabled(Astro);

// REQUIRED: the deferred response flows through the same URL-keyed memoryCache
// (Cookie stripped from Vary), so without this a cached account response would
// cross-serve one viewer's identity to everyone. Never store this render.
if (Astro.cache.enabled) Astro.cache.set(false);
---

<AccountMenu
  viewer={viewer}
  isPreview={isPreview}
  condensed={condensed}
  mobile={mobile}
/>
