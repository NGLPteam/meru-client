---
// Global footer composition (Astro). Replaces the former AppFooter.tsx client
// island so the per-viewer "Explore" nav (admin link / sign-in) can be a
// `server:defer` island: the footer body is cache-safe and viewer-free, while
// FooterNav renders per-request and opts out of the cache. Grid placement is by
// named areas, so body and nav can be separate siblings in any DOM order.
import type { FragmentType } from "@/lib/api/gql";
import type { AppFooterFragment } from "./graphql";
import type GlobalIslandProviders from "@/components/providers/GlobalIslandProviders";
import type { ActiveCommunityRef } from "@/components/global/graphql";
import FooterBodyIsland from "./FooterBodyIsland";
import FooterNav from "./FooterNav.astro";
import FooterNavContent from "./FooterNavContent.astro";
import styles from "./AppFooter.module.css";

type IslandProviderProps = React.ComponentProps<typeof GlobalIslandProviders>;

interface Props {
  data?: FragmentType<typeof AppFooterFragment> | null;
  globalData?: IslandProviderProps["globalData"];
  community?: ActiveCommunityRef;
}

const { data, globalData, community } = Astro.props;
---

<footer class:list={["a-bg-custom20", styles.footer]}>
  <div class:list={["l-container-wide", styles.inner]}>
    <FooterBodyIsland
      client:load
      data={data}
      globalData={globalData}
      community={community}
    />
    <FooterNav server:defer>
      <FooterNavContent slot="fallback" />
    </FooterNav>
  </div>
</footer>
