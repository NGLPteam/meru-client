---
// Route-based visibility (community-root vs. elsewhere) is computed here from
// Astro.url and re-evaluated on every navigation.
import SkipLink from "@/components/global/SkipLink";
import { useFragment, type FragmentType } from "@/lib/api/gql";
import { searchButtonFragment } from "@/components/atomic/SearchButton/graphql";
import CommunityName from "@/components/composed/community/CommunityName";
import { AppHeaderFragment } from "./graphql";
import HeaderBrand from "./HeaderBrand.astro";
import HeaderNav from "./HeaderNav.astro";
import HeaderMobileMenu from "./HeaderMobileMenu.astro";
import AccountNav from "@/components/global/AccountNav/AccountNav.astro";
import AccountMenu from "@/components/global/AccountNav/AccountMenu.astro";
import {
  ActiveCommunityFragment,
  type ActiveCommunityRef,
} from "@/components/global/graphql";
import styles from "./AppHeader.module.css";

interface Props {
  data?: FragmentType<typeof AppHeaderFragment> | null;
  searchData?: FragmentType<typeof searchButtonFragment> | null;
  community?: ActiveCommunityRef;
  // The current route's community-page slug, for the nav's active-page state.
  pageSlug?: string;
}

const { data, searchData, community, pageSlug } = Astro.props;

const appData = useFragment(AppHeaderFragment, data);
const activeCommunity = useFragment(ActiveCommunityFragment, community);

const pathname = Astro.url.pathname;
const isCommunityRoot = /^\/communities\/[A-Za-z0-9]{30,32}/.test(pathname);
const hideSearch = pathname === "/" || pathname === "/search";
const totalCommunities = appData?.communities?.pageInfo.totalCount || 0;

const showBrand = !isCommunityRoot || totalCommunities > 1;
const showNav = !isCommunityRoot && !hideSearch;
---

<SkipLink toId="main" />
<header class={styles.header}>
  <div class:list={["l-container-wide", styles.inner]}>
    <div class={styles.left}>
      {showBrand && <HeaderBrand data={data} community={community} />}
    </div>
    <div class={styles.right}>
      {
        showNav && (
          <HeaderNav
            searchData={searchData}
            community={community}
            pageSlug={pageSlug}
          />
        )
      }
      {
        /* Persist the resolved account island across soft navigations so authed
          users don't see the sign-in fallback re-flash on every page change
          (identity is session-stable; sign-in/out hard-reload). The rest of the
          header re-renders per nav for route-based gating. */
      }
      <AccountNav
        server:defer
        transition:persist="account-nav"
        condensed={!isCommunityRoot}
      >
        <AccountMenu slot="fallback" condensed={!isCommunityRoot} />
      </AccountNav>
    </div>
    <div class={styles.mobileRight}>
      <HeaderMobileMenu data={data} community={community} pageSlug={pageSlug} />
    </div>
  </div>
</header>
<div class={styles.printHeader} aria-hidden>
  <CommunityName data={activeCommunity} />
</div>
