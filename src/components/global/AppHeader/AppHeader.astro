---
// Global header composition (Astro). Replaces the former monolithic AppHeader.tsx
// client island so the per-viewer account nav can be a `server:defer` island: the
// page shell (logo, community picker, nav, search) is cache-safe and viewer-free,
// while AccountNav renders per-request and opts out of the cache.
//
// Route-based visibility (community-root vs. elsewhere) is computed here from
// Astro.url and re-evaluated on every navigation, so the header no longer needs a
// client usePathname() for gating. Interactive leaves stay React islands; their
// <astro-island> wrappers are display:contents, so the flex layout is unaffected.
import SkipLink from "@/components/global/SkipLink";
import { useFragment, type FragmentType } from "@/lib/api/gql";
import { fragment as SearchButtonFragment } from "@/components/atomic/SearchButton/SearchButton";
import { AppHeaderFragment } from "./graphql";
import HeaderBrandIsland from "./HeaderBrandIsland";
import HeaderNavIsland from "./HeaderNavIsland";
import HeaderMobileMenu from "./HeaderMobileMenu.astro";
import HeaderPrintName from "./HeaderPrintName";
import AccountNav from "@/components/chrome/AccountNav/AccountNav.astro";
import AccountDropdownIsland from "@/components/chrome/AccountNav/AccountDropdownIsland";
import type ChromeLeafProviders from "@/components/chrome/ChromeLeafProviders";
import styles from "./AppHeader.module.css";

type LeafProviderProps = React.ComponentProps<typeof ChromeLeafProviders>;

interface Props {
  data?: FragmentType<typeof AppHeaderFragment> | null;
  searchData?: FragmentType<typeof SearchButtonFragment> | null;
  globalData?: LeafProviderProps["globalData"];
  community?: LeafProviderProps["community"];
  route?: LeafProviderProps["route"];
}

const { data, searchData, globalData, community, route } = Astro.props;

const appData = useFragment(AppHeaderFragment, data);

const pathname = Astro.url.pathname;
const isCommunityRoot = /^\/communities\/[A-Za-z0-9]{30,32}/.test(pathname);
const hideSearch = pathname === "/" || pathname === "/search";
const totalCommunities = appData?.communities?.pageInfo.totalCount || 0;

// Match the former AppHeader.tsx branching.
const showBrand = !isCommunityRoot || totalCommunities > 1;
const showNav = !isCommunityRoot && !hideSearch;
---

<SkipLink toId="main" />
<header class={styles.header}>
  <div class:list={["l-container-wide", styles.inner]}>
    <div class={styles.left}>
      {
        showBrand && (
          <HeaderBrandIsland
            client:load
            data={data}
            globalData={globalData}
            community={community}
            route={route}
          />
        )
      }
    </div>
    <div class={styles.right}>
      {
        showNav && (
          <HeaderNavIsland
            client:load
            searchData={searchData}
            globalData={globalData}
            community={community}
            route={route}
          />
        )
      }
      {/* Persist the resolved account island across soft navigations so authed
          users don't see the sign-in fallback re-flash on every page change
          (identity is session-stable; sign-in/out hard-reload). The rest of the
          header re-renders per nav for route-based gating. */}
      <AccountNav
        server:defer
        transition:persist="account-nav"
        condensed={!isCommunityRoot}
      >
        <AccountDropdownIsland slot="fallback" condensed={!isCommunityRoot} />
      </AccountNav>
    </div>
    <div class={styles.mobileRight}>
      <HeaderMobileMenu
        data={data}
        globalData={globalData}
        community={community}
        route={route}
      />
    </div>
  </div>
</header>
<div class={styles.printHeader} aria-hidden>
  <HeaderPrintName
    globalData={globalData}
    community={community}
    route={route}
  />
</div>
