---
// Header mobile menu as a native <dialog>. MobileMenuManager (framework-free
// custom element) wires the toggle + close; the per-viewer account nav is a
// `server:defer` island sibling in the dialog body.
import MobileMenuToggle from "@/components/layout/MobileMenuToggle";
import { CloseModalButton } from "@/components/atomic";
import MobileMenuManager from "@/components/global/MobileMenuManager.astro";
import AccountNav from "@/components/global/AccountNav/AccountNav.astro";
import AccountMenu from "@/components/global/AccountNav/AccountMenu.astro";
import CommunityPicker from "@/components/composed/instance/CommunityPicker/CommunityPicker.astro";
import CommunityNavList from "@/components/composed/community/CommunityNavList/CommunityNavList.astro";
import InstallationName from "@/components/composed/instance/InstallationName";
import Search from "@/components/forms/Search/Search.astro";
import { useFragment, type FragmentType } from "@/lib/api/gql";
import { AppHeaderFragment } from "./graphql";
import {
  ActiveCommunityFragment,
  type ActiveCommunityRef,
} from "@/components/global/graphql";
import styles from "./HeaderMobileMenu.module.css";

interface Props {
  data?: FragmentType<typeof AppHeaderFragment> | null;
  community?: ActiveCommunityRef;
  pageSlug?: string;
}

const { data, community, pageSlug } = Astro.props;

const appData = useFragment(AppHeaderFragment, data);
const activeCommunity = useFragment(ActiveCommunityFragment, community);

const MENU_ID = "app-header-menu";
---

<MobileMenuManager>
  <MobileMenuToggle aria-controls={MENU_ID} aria-expanded="false" />
  {
    /* aria-label is English until per-request i18n lands (deferred; single-locale). */
  }
  <dialog id={MENU_ID} class={styles.dialog} aria-label="Menu">
    <div class={styles.panel}>
      <div class={styles.header}>
        <CommunityPicker data={appData} activeData={activeCommunity} />
        <form method="dialog">
          <CloseModalButton />
        </form>
      </div>
      <div class={styles.content}>
        <div class={styles.contentInner}>
          <div class={styles.list}>
            <CommunityNavList
              mobile
              data={activeCommunity}
              pageSlug={pageSlug}
            />
            <Search id="headerSearch" mobile />
            <AccountNav server:defer mobile>
              <AccountMenu slot="fallback" mobile />
            </AccountNav>
          </div>
        </div>
      </div>
      <footer class:list={["a-bg-custom10", styles.footer]}>
        <InstallationName data={appData?.globalConfiguration} />
      </footer>
    </div>
  </dialog>
</MobileMenuManager>
