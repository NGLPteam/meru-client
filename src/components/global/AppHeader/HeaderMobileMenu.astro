---
// Header mobile menu as a native <dialog> (the reakit BaseDrawer it replaced is
// gone — reakit is React-19-incompatible). Authoring it in Astro lets the
// per-viewer account nav be a real `server:defer` island placed as a sibling in
// the dialog body, rather than baked into a client-only React tree.
// MobileMenuManager (framework-free custom element) wires the toggle + close.
import MobileMenuToggle from "@/components/layout/MobileMenuToggle";
import { CloseModalButton } from "@/components/atomic";
import MobileMenuManager from "@/components/global/MobileMenuManager.astro";
import AccountNav from "@/components/global/AccountNav/AccountNav.astro";
import AccountDropdownIsland from "@/components/global/AccountNav/AccountDropdownIsland";
import { MobilePicker, MobileNav } from "./HeaderMobileParts";
import InstallationName from "@/components/composed/instance/InstallationName";
import { useFragment, type FragmentType } from "@/lib/api/gql";
import { AppHeaderFragment } from "./graphql";
import type GlobalIslandProviders from "@/components/providers/GlobalIslandProviders";
import type { ActiveCommunityRef } from "@/components/global/graphql";
import styles from "./HeaderMobileMenu.module.css";

type IslandProviderProps = React.ComponentProps<typeof GlobalIslandProviders>;

interface Props {
  data?: FragmentType<typeof AppHeaderFragment> | null;
  globalData?: IslandProviderProps["globalData"];
  community?: ActiveCommunityRef;
  pageSlug?: string;
}

const { data, globalData, community, pageSlug } = Astro.props;

const appData = useFragment(AppHeaderFragment, data);

// Keep in sync with MENU_ID in HeaderMobileParts.tsx.
const MENU_ID = "app-header-menu";
---

<MobileMenuManager>
  <MobileMenuToggle aria-controls={MENU_ID} aria-expanded="false" />
  {
    /* aria-label is English until per-request i18n lands (deferred; single-locale). */
  }
  <dialog id={MENU_ID} class={styles.dialog} aria-label="Menu">
    <div class={styles.panel}>
      <div class={styles.header}>
        <MobilePicker
          client:load
          data={data}
          globalData={globalData}
          community={community}
        />
        <form method="dialog">
          <CloseModalButton />
        </form>
      </div>
      <div class={styles.content}>
        <div class={styles.contentInner}>
          <div class={styles.list}>
            <MobileNav
              client:load
              globalData={globalData}
              community={community}
              pageSlug={pageSlug}
            />
            <AccountNav server:defer mobile>
              <AccountDropdownIsland slot="fallback" mobile />
            </AccountNav>
          </div>
        </div>
      </div>
      <footer class:list={["a-bg-custom10", styles.footer]}>
        <InstallationName data={appData?.globalConfiguration} />
      </footer>
    </div>
  </dialog>
</MobileMenuManager>
