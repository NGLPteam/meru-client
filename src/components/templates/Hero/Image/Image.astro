---
import classNames from "classnames";
import { useFragment, type FragmentType } from "@/lib/api/gql";
import type { HeroImageLayout } from "@/types/graphql-schema";
import { generateSrcSet, sizes } from "@/helpers/generateSrcSet";
import type { ImageSize } from "@/types/graphql-schema";
import { imageHeroTemplateFragment } from "./graphql";
import styles from "./Image.module.css";

interface Props {
  data: FragmentType<typeof imageHeroTemplateFragment> | null;
  layout?: HeroImageLayout;
}

const { data, layout } = Astro.props;

const images = useFragment(imageHeroTemplateFragment, data);

const { url, alt, height, width } = images?.hero?.webp ?? {};
---

{
  images && url && (
    <div
      class={
        layout
          ? classNames(styles.gridWrapper, {
              [styles["gridWrapper--two-column"]]: layout === "TWO_COLUMN",
            })
          : styles.baseWrapper
      }
    >
      <img
        alt={alt ?? ""}
        src={url}
        srcset={generateSrcSet(images as unknown as Record<string, ImageSize>)}
        sizes={sizes}
        height={height ?? 425}
        width={width ?? 585}
        class={classNames(styles.image, {
          [styles["image--one-column"]]: layout === "ONE_COLUMN",
        })}
        decoding="async"
        loading="eager"
      />
    </div>
  )
}
