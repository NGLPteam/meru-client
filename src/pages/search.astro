---
// Global search — Astro port of app/[frontend]/(pages)/search/page.tsx.
import BaseLayout from "~/layouts/BaseLayout.astro";
import query from "~/lib/query";
import { query as globalStaticQuery } from "@/contexts/GlobalStaticContext/getStaticGlobalContextData.query";
import { globalSearchQuery } from "~/lib/queries/search";
import GlobalSearch from "~/components/pages/GlobalSearch";
import { getPredicates } from "@/helpers/search";
import type { EntityOrder } from "@/types/graphql-schema";

const sp = Astro.url.searchParams;
const q = sp.get("q") ?? undefined;
const filters = sp.get("filters");
const page = sp.get("page");
const order = sp.get("order");
const schema = sp.get("schema");

const predicates = filters ? getPredicates(JSON.parse(filters)) : [];

const { data } = await query(globalSearchQuery, {
  ...(q && { query: q }),
  predicates,
  page: page ? parseInt(page) : 1,
  order: (order ?? "PUBLISHED_ASCENDING") as EntityOrder,
  schema: schema ? schema.split(",") : [],
});
if (!data) return Astro.rewrite("/404");

const { data: globalData } = await query(globalStaticQuery, {});
const route = {
  pathname: Astro.url.pathname,
  search: Astro.url.search,
  params: Astro.params,
};
---

<BaseLayout meta={{ title: "Search" }}>
  <GlobalSearch
    client:load
    data={data}
    globalData={globalData}
    route={route}
  />
</BaseLayout>
