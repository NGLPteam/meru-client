---
import "@/i18n";
import { useFragment, type FragmentType } from "@/lib/api/gql";
import { collectionShellFragment } from "@/pages/collections/_components/graphql";
import UnauthorizedMessage from "@/components/composed/UnauthorizedMessage/UnauthorizedMessage.astro";
import HeroTemplate, {
  getHeroBreadcrumbProps,
} from "@/components/templates/Hero";
import BreadcrumbsBar from "@/components/layout/BreadcrumbsBar/BreadcrumbsBar.astro";
import ProcessingCheck, {
  hasMainContent,
} from "@/components/templates/ProcessingCheck";
import EntityNavBar from "@/components/composed/entity/EntityNavBar/EntityNavBar.astro";
import { getEntityNavBarData } from "@/components/composed/entity/EntityNavBar/getEntityNavBarData";
import ViewCounter from "@/components/client/ViewCounter.astro";

interface Props {
  data: FragmentType<typeof collectionShellFragment>;
  slug: string;
  draftModeEnabled: boolean;
  installationName?: string;
}

const { data, slug, draftModeEnabled, installationName } = Astro.props;

const shell = useFragment(collectionShellFragment, data);

const unauthorized = draftModeEnabled && !shell.canPreview?.value;

const hero = shell.layouts.hero;
const breadcrumbs = hero ? getHeroBreadcrumbProps(hero) : null;
const navBarData = getEntityNavBarData(shell);
const empty = !hasMainContent(shell.layouts);
const pathname = Astro.url.pathname;
---

{
  unauthorized ? (
    <UnauthorizedMessage reason="forbidden" entity="collection" />
  ) : (
    <>
      {breadcrumbs && (
        <BreadcrumbsBar
          {...breadcrumbs}
          installationName={installationName}
          pathname={pathname}
        />
      )}
      {hero && <HeroTemplate data={hero} />}
      {empty ? (
        <ProcessingCheck data={shell.layouts} entityType="collection" />
      ) : (
        <>
          <ViewCounter slug={slug} paused={draftModeEnabled} />
          <EntityNavBar data={navBarData} pathname={pathname} />
          <slot />
        </>
      )}
    </>
  )
}
