---
import BaseLayout from "~/layouts/BaseLayout.astro";
import query from "~/lib/query";
import { previewToken } from "~/lib/request/previewToken";
import { isDraftModeEnabled } from "~/lib/request/draftMode";
import { query as globalStaticQuery } from "@/contexts/GlobalStaticContext/getStaticGlobalContextData.query";
import { collectionBrowseQuery } from "~/pages/collections/_components/graphql";
import buildCollectionMeta from "~/lib/metadata/collectionMetadata";
import CollectionShell from "../../_components/CollectionShell.astro";
import OrderingList from "@/components/composed/entity/EntityOrderingLayout/OrderingList.astro";
import LoadingBlock from "@/components/atomic/loading/LoadingBlock";
import type { ListEntityContext } from "@/types/graphql-schema";

const { slug, ordering } = Astro.params;
if (!slug || !ordering) return Astro.rewrite("/404");

const page = parseInt(Astro.url.searchParams.get("page") ?? "") || 1;
const showContext =
  (Astro.url.searchParams.get("context") as ListEntityContext | null) ??
  undefined;

const { data } = await query(
  collectionBrowseQuery,
  { slug },
  previewToken(Astro),
);
const collection = data?.collection;
if (!collection) return Astro.rewrite("/404");

const { data: globalData } = await query(globalStaticQuery, {});
const installationName =
  globalData?.globalConfiguration?.site?.installationName ?? undefined;
const meta = buildCollectionMeta(collection, slug);
const draftModeEnabled = isDraftModeEnabled(Astro);
---

<BaseLayout meta={meta} community={collection.community}>
  <CollectionShell
    data={collection}
    slug={slug}
    draftModeEnabled={draftModeEnabled}
    installationName={installationName}
  >
    <OrderingList
      server:defer
      entityType="collection"
      slug={slug}
      identifier={ordering}
      page={page}
      showContext={showContext}
      pathname={Astro.url.pathname}
      search={Astro.url.search}
    >
      <LoadingBlock
        slot="fallback"
        className="l-container-wide l-container-wide--p-lg"
      />
    </OrderingList>
  </CollectionShell>
</BaseLayout>
