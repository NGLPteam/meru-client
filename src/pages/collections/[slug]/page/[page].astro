---
// Named collection sub-page — Astro port of collections/[slug]/page/[page]/page.tsx.
import BaseLayout from "~/layouts/BaseLayout.astro";
import query from "~/lib/query";
import { query as globalStaticQuery } from "@/contexts/GlobalStaticContext/getStaticGlobalContextData.query";
import { collectionPageQuery } from "~/lib/queries/collection";
import buildCollectionMeta from "~/lib/metadata/collectionMetadata";
import CollectionPage from "~/components/pages/collection/CollectionPage";

const { slug, page: pageSlug } = Astro.params;
if (!slug || !pageSlug) return new Response(null, { status: 404 });

const { data } = await query(collectionPageQuery, { slug, pageSlug });
const collection = data?.collection;
if (!collection) return new Response(null, { status: 404 });

const { data: globalData } = await query(globalStaticQuery, {});
const meta = buildCollectionMeta(collection, slug);
const route = {
  pathname: Astro.url.pathname,
  search: Astro.url.search,
  params: Astro.params,
};
---

<BaseLayout meta={meta} community={collection.community} routeParams={{ slug, page: pageSlug }}>
  <CollectionPage
    client:load
    collection={collection}
    slug={slug}
    globalData={globalData}
    route={route}
  />
</BaseLayout>
