---
// Collection contributors — Astro port of collections/[slug]/contributors/page.tsx.
import BaseLayout from "~/layouts/BaseLayout.astro";
import { cacheEntity } from "@/lib/caching/setCache";
import query from "~/lib/query";
import getViewer from "~/lib/auth/viewer";
import { previewToken } from "~/lib/request/previewToken";
import { isDraftModeEnabled } from "~/lib/request/draftMode";
import { query as globalStaticQuery } from "@/contexts/GlobalStaticContext/getStaticGlobalContextData.query";
import { collectionContributorsQuery } from "~/lib/queries/collection";
import buildCollectionMeta from "~/lib/metadata/collectionMetadata";
import CollectionContributors from "~/components/pages/collection/CollectionContributors";

const { slug } = Astro.params;
if (!slug) return Astro.rewrite("/404");

const { data } = await query(
  collectionContributorsQuery,
  { slug },
  previewToken(Astro),
);
const collection = data?.collection;
if (!collection) return Astro.rewrite("/404");

const { data: globalData } = await query(globalStaticQuery, {});
const meta = buildCollectionMeta(collection, slug);
const route = {
  pathname: Astro.url.pathname,
  search: Astro.url.search,
  params: Astro.params,
};
const viewer = await getViewer(Astro);
const draftModeEnabled = isDraftModeEnabled(Astro);

cacheEntity(Astro, "collection", slug);
---

<BaseLayout meta={meta} community={collection.community} routeParams={{ slug }}>
  <CollectionContributors
    client:load
    collection={collection}
    slug={slug}
    globalData={globalData}
    route={route}
    viewer={viewer}
    draftModeEnabled={draftModeEnabled}
  />
</BaseLayout>
