---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { cacheEntity } from "@/lib/caching/setCache";
import query from "~/lib/query";
import { previewToken } from "~/lib/request/previewToken";
import { isDraftModeEnabled } from "~/lib/request/draftMode";
import { query as globalStaticQuery } from "@/contexts/GlobalStaticContext/getStaticGlobalContextData.query";
import { collectionAnnouncementQuery } from "~/lib/queries/collection";
import buildCollectionMeta from "~/lib/metadata/collectionMetadata";
import CollectionShell from "../../_components/CollectionShell.astro";
import EntityAnnouncementLayout from "@/components/composed/entity/EntityAnnouncementLayout";

const { slug, announcement } = Astro.params;
if (!slug || !announcement) return Astro.rewrite("/404");

const { data } = await query(
  collectionAnnouncementQuery,
  {
    slug,
    announcementSlug: announcement,
  },
  previewToken(Astro),
);
const collection = data?.collection;
if (!collection) return Astro.rewrite("/404");

const { data: globalData } = await query(globalStaticQuery, {});
const installationName =
  globalData?.globalConfiguration?.site?.installationName ?? undefined;
const meta = buildCollectionMeta(collection, slug);
const draftModeEnabled = isDraftModeEnabled(Astro);

cacheEntity(Astro, "collection", slug);
---

<BaseLayout
  meta={meta}
  community={collection.community}
  routeParams={{ slug, announcement }}
>
  <CollectionShell
    data={collection}
    slug={slug}
    draftModeEnabled={draftModeEnabled}
    installationName={installationName}
  >
    <EntityAnnouncementLayout data={collection.announcement} />
  </CollectionShell>
</BaseLayout>
