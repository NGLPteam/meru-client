---
import { useFragment, type FragmentType } from "@/lib/api/gql";
import { itemShellFragment } from "@/pages/items/_components/graphql";
import UnauthorizedMessage from "@/components/composed/UnauthorizedMessage/UnauthorizedMessage.astro";
import HeroTemplate from "@/components/templates/Hero/Hero.astro";
import { getHeroBreadcrumbProps } from "@/components/templates/Hero/getHeroProps";
import BreadcrumbsBar from "@/components/layout/BreadcrumbsBar/BreadcrumbsBar.astro";
import ProcessingCheck from "@/components/templates/ProcessingCheck/ProcessingCheck.astro";
import { hasMainContent } from "@/components/templates/ProcessingCheck/graphql";
import NavigationTemplate from "@/components/templates/EntityNavigation/EntityNavigation.astro";
import EntityNavBar from "@/components/composed/entity/EntityNavBar/EntityNavBar.astro";
import { getEntityNavBarData } from "@/components/composed/entity/EntityNavBar/getEntityNavBarData";
import ViewCounter from "@/components/client/ViewCounter.astro";
import { shouldRenderMainLayout } from "@/components/templates/FullTextCheck/FullTextCheck";

interface Props {
  data: FragmentType<typeof itemShellFragment>;
  slug: string;
  draftModeEnabled: boolean;
  installationName?: string;
}

const { data, slug, draftModeEnabled, installationName } = Astro.props;

const shell = useFragment(itemShellFragment, data);

const unauthorized = draftModeEnabled && !shell.canPreview?.value;

const { hero, navigation } = shell.layouts ?? {};
const breadcrumbs = hero ? getHeroBreadcrumbProps(hero) : null;
const navBarData = getEntityNavBarData(shell);
const empty = !hasMainContent(shell.layouts);
const renderMainLayout = shouldRenderMainLayout(shell.layouts);
const pathname = Astro.url.pathname;
---

{
  unauthorized ? (
    <UnauthorizedMessage reason="forbidden" entity="item" />
  ) : (
    <>
      {breadcrumbs && (
        <BreadcrumbsBar
          {...breadcrumbs}
          installationName={installationName}
          pathname={pathname}
        />
      )}
      {hero && <HeroTemplate data={hero} />}
      {empty ? (
        <ProcessingCheck data={shell.layouts} entityType="item" />
      ) : (
        <>
          <ViewCounter slug={slug} paused={draftModeEnabled} />
          <EntityNavBar data={navBarData} pathname={pathname} />
          <NavigationTemplate
            data={navigation}
            slug={slug}
            pathname={pathname}
            renderMainLayout={renderMainLayout}
          />
          <slot />
        </>
      )}
    </>
  )
}
