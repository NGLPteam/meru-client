---
import "@/i18n";
import { useFragment as readFragment, type FragmentType } from "@/lib/api/gql";
import { itemShellFragment } from "@/pages/items/_components/graphql";
import UnauthorizedMessage from "@/components/composed/UnauthorizedMessage";
import HeroTemplate, {
  getHeroBreadcrumbProps,
} from "@/components/templates/Hero";
import BreadcrumbsBar from "@/components/layout/BreadcrumbsBar";
import ProcessingCheck, {
  hasMainContent,
} from "@/components/templates/ProcessingCheck";
import NavigationTemplate from "@/components/templates/EntityNavigation";
import EntityNavBar, {
  getEntityNavBarData,
} from "@/components/composed/entity/EntityNavBar";
import ViewCounter from "@/components/composed/analytics/ViewCounter";
import { shouldRenderMainLayout } from "@/components/templates/FullTextCheck/FullTextCheck";

interface Props {
  data: FragmentType<typeof itemShellFragment>;
  slug: string;
  draftModeEnabled: boolean;
  installationName?: string;
}

const { data, slug, draftModeEnabled, installationName } = Astro.props;

const shell = readFragment(itemShellFragment, data);

const unauthorized = draftModeEnabled && !shell.canPreview?.value;

const { hero, navigation } = shell.layouts ?? {};
const breadcrumbs = hero ? getHeroBreadcrumbProps(hero) : null;
const navBarData = getEntityNavBarData(shell);
const empty = !hasMainContent(shell.layouts);
const renderMainLayout = shouldRenderMainLayout(shell.layouts);
const pathname = Astro.url.pathname;
---

{
  unauthorized ? (
    <UnauthorizedMessage reason="forbidden" entity="item" />
  ) : (
    <>
      {breadcrumbs && (
        <BreadcrumbsBar
          client:load
          {...breadcrumbs}
          installationName={installationName}
          pathname={pathname}
        />
      )}
      {hero && <HeroTemplate data={hero} hideBreadcrumbsBar />}
      {empty ? (
        <ProcessingCheck data={shell.layouts} entityType="item" />
      ) : (
        <>
          <ViewCounter client:load slug={slug} isPreview={draftModeEnabled} />
          <EntityNavBar client:load data={navBarData} pathname={pathname} />
          <NavigationTemplate
            data={navigation}
            slug={slug}
            pathname={pathname}
            renderMainLayout={renderMainLayout}
          />
          <slot />
        </>
      )}
    </>
  )
}
