---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { cacheEntity } from "@/lib/caching/setCache";
import query from "~/lib/query";
import { previewToken } from "~/lib/request/previewToken";
import { isDraftModeEnabled } from "~/lib/request/draftMode";
import { useFragment } from "@/lib/api/gql";
import { query as globalStaticQuery } from "@/contexts/GlobalStaticContext/getStaticGlobalContextData.query";
import { fragment as googleScholarFragment } from "@/contexts/GlobalStaticContext/getStaticGoogleScholarData";
import { itemMetricsQuery } from "~/pages/items/_components/graphql";
import buildItemMeta from "~/lib/metadata/itemMetadata";
import ItemShell from "../_components/ItemShell.astro";
import ArticleAnalyticsBlock from "@/components/composed/analytics/ArticleAnalyticsBlock";
import { layoutThemeQuery } from "~/layouts/graphql";
import GoogleScholarMetaTags from "@/components/global/GoogleScholarMetaTags";
import type { AnalyticsPrecision } from "@/types/graphql-schema";

const { slug } = Astro.params;
if (!slug) return Astro.rewrite("/404");

const { data } = await query(
  itemMetricsQuery,
  {
    slug,
    dateRange: {},
    precision: "YEAR" as AnalyticsPrecision,
    usOnly: false,
  },
  previewToken(Astro),
);
const item = data?.item;
if (!item) return Astro.rewrite("/404");

const { data: globalData } = await query(globalStaticQuery, {});
const installationName =
  globalData?.globalConfiguration?.site?.installationName ?? undefined;
const { data: themeData } = await query(layoutThemeQuery, {});
const theme = themeData?.globalConfiguration?.theme ?? undefined;
const draftModeEnabled = isDraftModeEnabled(Astro);

// Translated strings for the charts island, keyed by i18n key — the island
// ships without i18next and looks its labels up in this record.
const { t } = Astro.locals;
const ANALYTICS_LABEL_KEYS = [
  "analytics.views",
  "analytics.downloads",
  "analytics.map",
  "analytics.chart",
  "analytics.regions.world",
  "analytics.regions.united_states",
  "analytics.date_ranges.dropdown_label",
  "analytics.date_ranges.all",
  "analytics.date_ranges.week",
  "analytics.date_ranges.month",
  "analytics.date_ranges.year",
  "analytics.views_all",
  "analytics.views_week",
  "analytics.views_month",
  "analytics.views_year",
  "analytics.downloads_all",
  "analytics.downloads_week",
  "analytics.downloads_month",
  "analytics.downloads_year",
  "analytics.top_state",
  "analytics.top_country",
];
const analyticsLabels = Object.fromEntries(
  ANALYTICS_LABEL_KEYS.map((key) => [key, t(key)]),
);
const meta = buildItemMeta(item, slug);
const scholar = useFragment(googleScholarFragment, item);

cacheEntity(Astro, "item", slug);
---

<BaseLayout meta={meta} community={item.community}>
  <GoogleScholarMetaTags slot="head" entity={scholar} />
  <ItemShell
    data={item}
    slug={slug}
    draftModeEnabled={draftModeEnabled}
    installationName={installationName}
  >
    <ArticleAnalyticsBlock
      client:load
      data={data?.analytics}
      themeColor={theme?.color}
      labels={analyticsLabels}
    />
  </ItemShell>
</BaseLayout>
