---
// Phase 1 demo: a page using the real BaseLayout (theme classes fetched + applied
// on <html>), rendering a Meru React component in the slot.
import BaseLayout from "../layouts/BaseLayout.astro";
import LoadingBlock from "@/components/atomic/loading/LoadingBlock";
---

<BaseLayout title="Meru — Astro Phase 1">
  <h1>Phase 1: BaseLayout</h1>
  <p>Theme classes are fetched server-side and applied to &lt;html&gt;.</p>
  <div style="height: 160px; border: 1px dashed #999;">
    <LoadingBlock />
  </div>
</BaseLayout>
