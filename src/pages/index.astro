---
// Home / instance page — Astro port of app/[frontend]/(pages)/page.tsx.
// Fetches the instance content, applies the single-community redirect / no-
// instance 404, and renders the hero + community list island in the slot.
import BaseLayout from "../layouts/BaseLayout.astro";
import query from "../lib/query";
import getViewer from "~/lib/auth/viewer";
import { instanceContentQuery } from "../lib/queries/home";
import { query as globalStaticQuery } from "@/contexts/GlobalStaticContext/getStaticGlobalContextData.query";
import InstanceContent from "../components/pages/InstanceContent";
import { cacheGlobal } from "@/lib/caching/setCache";

const { data: instance } = await query(instanceContentQuery, {});

// A single-community instance is that community's site — send the root there.
const total = instance?.communities?.pageInfo?.totalCount ?? 0;
const firstSlug = instance?.communities?.edges[0]?.node?.slug ?? null;
if (total === 1 && firstSlug) {
  return Astro.redirect(`/communities/${firstSlug}`);
}

if (!instance) {
  return Astro.rewrite("/404");
}

const { data: globalData } = await query(globalStaticQuery, {});
const viewer = await getViewer(Astro);

const route = {
  pathname: Astro.url.pathname,
  search: Astro.url.search,
  params: Astro.params,
};

// Home depends only on installation-wide data — GLOBAL_TAG, no entity tag.
cacheGlobal(Astro);
---

<BaseLayout>
  <InstanceContent
    client:load
    data={instance}
    communities={instance.communities}
    globalData={globalData}
    route={route}
    viewer={viewer}
  />
</BaseLayout>
