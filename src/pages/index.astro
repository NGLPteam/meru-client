---
// Phase 1 demo: a page using the real BaseLayout — theme classes on <html>,
// global chrome (header + footer islands) around this page content in the slot.
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Meru — Astro Phase 1">
  <section class="l-container-wide" style="padding-block: 4rem;">
    <h1 class="t-h1">Phase 1: chrome shell</h1>
    <p class="t-copy">
      Server-rendered page content. The header and footer above/below are
      hydrated Astro islands fed server data; this region is a plain
      <code>&lt;slot /&gt;</code>.
    </p>
  </section>
</BaseLayout>
