---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { cacheEntity } from "@/lib/caching/setCache";
import query from "~/lib/query";
import {
  contributorDetailQuery,
  contributorItemQuery,
  contributorCollectionQuery,
} from "~/pages/contributors/_components/graphql";
import ContributorDetail from "@/components/composed/contributor/ContributorDetail/ContributorDetail.astro";
import ContributorDetailNav from "@/components/composed/contributor/ContributorDetailNav";

const { slug } = Astro.params;
if (!slug) return Astro.rewrite("/404");

const sp = Astro.url.searchParams;
const item = sp.get("item") ?? undefined;
const collection = sp.get("collection") ?? undefined;
const page = parseInt(sp.get("page") ?? "1") || 1;

let contributor;
let navData;
let community;
if (item) {
  const { data } = await query(contributorItemQuery, { slug, item, page });
  contributor = data?.contributor;
  navData = data?.item;
  community = data?.item?.community;
} else if (collection) {
  const { data } = await query(contributorCollectionQuery, {
    slug,
    collection,
    page,
  });
  contributor = data?.contributor;
  navData = data?.collection;
  community = data?.collection?.community;
} else {
  const { data } = await query(contributorDetailQuery, { slug, page });
  contributor = data?.contributor;
}

if (!contributor) return Astro.rewrite("/404");

cacheEntity(Astro, "contributor", slug);
---

<BaseLayout community={community} routeParams={{ slug }}>
  {navData && <ContributorDetailNav data={navData} />}
  <ContributorDetail data={contributor} />
</BaseLayout>
