---
// Named community sub-page — Astro port of communities/[slug]/page/[page]/page.tsx.
import BaseLayout from "~/layouts/BaseLayout.astro";
import { cacheEntity } from "@/lib/caching/setCache";
import query from "~/lib/query";
import { previewToken } from "~/lib/request/previewToken";
import { isDraftModeEnabled } from "~/lib/request/draftMode";
import { query as globalStaticQuery } from "@/contexts/GlobalStaticContext/getStaticGlobalContextData.query";
import { communityPageQuery } from "~/lib/queries/community";
import buildCommunityMeta from "~/lib/metadata/communityMetadata";
import CommunityPage from "~/components/pages/community/CommunityPage";

const { slug, page: pageSlug } = Astro.params;
if (!slug || !pageSlug) return Astro.rewrite("/404");

const { data } = await query(communityPageQuery, { slug, pageSlug }, previewToken(Astro));
const community = data?.community;
if (!community) return Astro.rewrite("/404");

const { data: globalData } = await query(globalStaticQuery, {});
const draftModeEnabled = isDraftModeEnabled(Astro);
const meta = buildCommunityMeta(community, slug);
const route = {
  pathname: Astro.url.pathname,
  search: Astro.url.search,
  params: Astro.params,
};

cacheEntity(Astro, "community", slug);
---

<BaseLayout meta={meta} community={community} routeParams={{ slug, page: pageSlug }}>
  <CommunityPage
    client:load
    community={community}
    globalData={globalData}
    route={route}
    draftModeEnabled={draftModeEnabled}
  />
</BaseLayout>
