---
import BaseLayout from "~/layouts/BaseLayout.astro";
import query from "~/lib/query";
import { previewToken } from "~/lib/request/previewToken";
import { isDraftModeEnabled } from "~/lib/request/draftMode";
import { communityBrowseQuery } from "~/pages/communities/_components/graphql";
import buildCommunityMeta from "~/lib/metadata/communityMetadata";
import CommunityShell from "../../_components/CommunityShell.astro";
import OrderingList from "@/components/composed/entity/EntityOrderingLayout/OrderingList.astro";
import LoadingBlock from "@/components/atomic/loading/LoadingBlock";

const { slug, ordering } = Astro.params;
if (!slug || !ordering) return Astro.rewrite("/404");

const page = parseInt(Astro.url.searchParams.get("page") ?? "") || 1;

const { data } = await query(
  communityBrowseQuery,
  { slug },
  previewToken(Astro),
);
const community = data?.community;
if (!community) return Astro.rewrite("/404");

const draftModeEnabled = isDraftModeEnabled(Astro);
const meta = buildCommunityMeta(community, slug);
---

<BaseLayout
  meta={meta}
  community={data?.communityRef}
  routeParams={{ slug, ordering }}
>
  <CommunityShell
    data={community}
    communityRef={data?.communityRef}
    draftModeEnabled={draftModeEnabled}
  >
    <OrderingList
      server:defer
      entityType="community"
      slug={slug}
      identifier={ordering}
      page={page}
      showContext="FULL"
    >
      <LoadingBlock
        slot="fallback"
        className="l-container-wide l-container-wide--p-lg"
      />
    </OrderingList>
  </CommunityShell>
</BaseLayout>
