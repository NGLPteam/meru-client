---
import BaseLayout from "~/layouts/BaseLayout.astro";
import query from "~/lib/query";
import { previewToken } from "~/lib/request/previewToken";
import { isDraftModeEnabled } from "~/lib/request/draftMode";
import { useFragment } from "@/lib/api/gql";
import { communitySearchQuery } from "~/pages/communities/_components/graphql";
import { searchLayoutEntityFragment } from "~/components/composed/search/graphql";
import buildCommunityMeta from "~/lib/metadata/communityMetadata";
import CommunityShell from "../_components/CommunityShell.astro";
import SearchLayout from "@/components/composed/search/SearchLayout/SearchLayout.astro";

const { slug } = Astro.params;
if (!slug) return Astro.rewrite("/404");

const { data } = await query(
  communitySearchQuery,
  { slug },
  previewToken(Astro),
);
const community = data?.community;
if (!community) return Astro.rewrite("/404");

const layout = useFragment(searchLayoutEntityFragment, community);

const draftModeEnabled = isDraftModeEnabled(Astro);
const meta = buildCommunityMeta(community, slug);
---

<BaseLayout meta={meta} community={data?.communityRef}>
  <CommunityShell
    data={community}
    communityRef={data?.communityRef}
    draftModeEnabled={draftModeEnabled}
  >
    <SearchLayout
      scope="community"
      slug={slug}
      searchFilters={layout.searchFilters}
      pathname={Astro.url.pathname}
      search={Astro.url.search}
    />
  </CommunityShell>
</BaseLayout>
