---
// Scoped community search — Astro port of communities/[slug]/search/page.tsx.
import BaseLayout from "~/layouts/BaseLayout.astro";
import query from "~/lib/query";
import getViewer from "~/lib/auth/viewer";
import { query as globalStaticQuery } from "@/contexts/GlobalStaticContext/getStaticGlobalContextData.query";
import { communitySearchQuery } from "~/lib/queries/community";
import buildCommunityMeta from "~/lib/metadata/communityMetadata";
import CommunitySearch from "~/components/pages/community/CommunitySearch";
import { getPredicates } from "@/helpers/search";
import type { EntityOrder } from "@/types/graphql-schema";

const { slug } = Astro.params;
if (!slug) return Astro.rewrite("/404");

const sp = Astro.url.searchParams;
const q = sp.get("q") ?? undefined;
const filters = sp.get("filters");
const page = sp.get("page");
const order = sp.get("order");
const schema = sp.get("schema");

const predicates = filters ? getPredicates(JSON.parse(filters)) : [];

const { data } = await query(communitySearchQuery, {
  slug,
  ...(q && { query: q }),
  predicates,
  page: page ? parseInt(page) : 1,
  order: (order ?? "PUBLISHED_ASCENDING") as EntityOrder,
  schema: schema ? schema.split(",") : [],
});
const community = data?.community;
if (!community) return Astro.rewrite("/404");

const { data: globalData } = await query(globalStaticQuery, {});
const viewer = await getViewer(Astro);
const meta = buildCommunityMeta(community, slug);
const route = {
  pathname: Astro.url.pathname,
  search: Astro.url.search,
  params: Astro.params,
};
---

<BaseLayout meta={meta} community={community} routeParams={{ slug }}>
  <CommunitySearch
    client:load
    community={community}
    globalData={globalData}
    route={route}
    viewer={viewer}
  />
</BaseLayout>
