---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { cacheEntity } from "@/lib/caching/setCache";
import query from "../../lib/query";
import { previewToken } from "../../lib/request/previewToken";
import { isDraftModeEnabled } from "../../lib/request/draftMode";
import { communityQuery } from "./_components/graphql";
import buildCommunityMeta from "../../lib/metadata/communityMetadata";
import CommunityShell from "./_components/CommunityShell.astro";
import MainLayout from "@/components/templates/MainLayout/MainLayout.astro";

const { slug } = Astro.params;
if (!slug) return Astro.rewrite("/404");

const { data } = await query(communityQuery, { slug }, previewToken(Astro));
const community = data?.community;
if (!community) return Astro.rewrite("/404");

const draftModeEnabled = isDraftModeEnabled(Astro);
const meta = buildCommunityMeta(community, slug);

// The narrow aliased selection — the full `community` (with all template slot
// content) must never be passed to islands or BaseLayout.
const communityRef = data?.communityRef;

cacheEntity(Astro, "community", slug);
---

<BaseLayout meta={meta} community={communityRef}>
  <CommunityShell
    data={community}
    communityRef={communityRef}
    draftModeEnabled={draftModeEnabled}
  >
    <MainLayout data={community.layouts.main} computedBgStart="NONE" />
  </CommunityShell>
</BaseLayout>
