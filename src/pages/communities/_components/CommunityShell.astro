---
import { useFragment, type FragmentType } from "@/lib/api/gql";
import { communityShellFragment } from "@/pages/communities/_components/graphql";
import UnauthorizedMessage from "@/components/composed/UnauthorizedMessage/UnauthorizedMessage.astro";
import HeroTemplate from "@/components/templates/Hero/Hero.astro";
import { getHeroSearchProps } from "@/components/templates/Hero/getHeroProps";
import SearchHero from "@/components/composed/search/SearchHero/SearchHero.astro";
import CommunityNavBar from "@/components/composed/community/CommunityNavBar/CommunityNavBar.astro";
import {
  communityNavBarFragment,
  communityNavBarEntityFragment,
} from "@/components/composed/community/CommunityNavBar/graphql";
import ProcessingCheck from "@/components/templates/ProcessingCheck/ProcessingCheck.astro";
import { hasMainContent } from "@/components/templates/ProcessingCheck/graphql";
interface Props {
  data: FragmentType<typeof communityShellFragment>;
  // Aliased narrow re-selection (communityRef) — see communityQuery.
  communityRef?:
    | (FragmentType<typeof communityNavBarFragment> &
        FragmentType<typeof communityNavBarEntityFragment>)
    | null;
  draftModeEnabled: boolean;
  // The current route's community-page slug, for the nav's active-page state.
  pageSlug?: string;
}

const { data, communityRef, draftModeEnabled, pageSlug } = Astro.props;

const shell = useFragment(communityShellFragment, data);

const unauthorized = draftModeEnabled && !shell.canPreview?.value;

const showNavBar =
  shell.layouts?.hero?.template?.definition?.enableDescendantBrowsing;
const hero = shell.layouts.hero;
const empty = !hasMainContent(shell.layouts);
const pathname = Astro.url.pathname;
const searchHero = hero ? getHeroSearchProps(hero, pathname) : null;
---

{
  unauthorized ? (
    <UnauthorizedMessage reason="forbidden" entity="community" />
  ) : (
    <>
      {showNavBar && (
        <CommunityNavBar
          data={communityRef}
          entityData={communityRef}
          pageSlug={pageSlug}
        />
      )}
      {empty ? (
        <ProcessingCheck data={shell.layouts} entityType="community" />
      ) : (
        <>
          {hero && <HeroTemplate data={hero} />}
          {searchHero && (
            <SearchHero prompt={searchHero.prompt} pathname={pathname} />
          )}
          <slot />
        </>
      )}
    </>
  )
}
