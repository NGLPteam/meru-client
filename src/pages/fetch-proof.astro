---
// Phase 0, milestone B: prove a real GraphQL fetch from .astro against the live
// API via the reused urql client. Plain-string query (codegen fragment masking
// comes next, in the fragment-proof step).
import query from "../lib/query";

const SITE_QUERY = `
  query Phase0SiteQuery {
    globalConfiguration {
      site {
        installationName
      }
    }
  }
`;

const { data, error } = await query(SITE_QUERY, {});
const installationName = (data as any)?.globalConfiguration?.site?.installationName;
---

<html lang="en">
  <head><meta charset="utf-8" /><title>fetch proof</title></head>
  <body>
    <h1>Phase 0 fetch proof</h1>
    {error ? <pre>ERROR: {String(error)}</pre> : (
      <p>installationName = <strong>{installationName ?? "(none)"}</strong></p>
    )}
  </body>
</html>
