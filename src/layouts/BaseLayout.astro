---
// The global header/footer is composed in Astro (AppHeader.astro /
// AppFooter.astro) around a plain Astro <slot/> — page content stays free to be
// its own server HTML + independent islands. Interactive header/footer parts
// are cache-safe islands (GlobalIslandProviders); per-viewer bits (account nav,
// footer admin/sign-in) render as `server:defer` islands that resolve the
// viewer per-request and opt out of the cache — so no viewer identity is
// serialized into cached page HTML.
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import { getThemeClasses } from "@/styles/theme-helpers";
import LoadingBar from "../components/client/LoadingBar.astro";
import query from "../lib/query";
import { isDraftModeEnabled } from "~/lib/request/draftMode";
import DraftModeBannerIsland from "../components/global/DraftModeBanner/DraftModeBannerIsland";
import {
  LayoutThemeAstroQuery,
  globalLayoutQuery,
} from "../lib/queries/layout";
import { query as globalStaticQuery } from "@/contexts/GlobalStaticContext/getStaticGlobalContextData.query";
import getSiteMetadata from "../lib/metadata/siteMetadata";
import resolvePageMeta from "../lib/metadata/resolvePageMeta";
import PageHead from "../components/head/PageHead.astro";
import AppHeader from "../components/global/AppHeader/AppHeader.astro";
import AppFooter from "../components/global/AppFooter/AppFooter.astro";
import type GlobalIslandProviders from "@/components/providers/GlobalIslandProviders";
import type { ComponentProps } from "react";
import type { PageMeta } from "@/lib/metadata/types";

type CommunityRef = ComponentProps<typeof GlobalIslandProviders>["community"];

interface Props {
  // Page-level metadata (title, description, og:images…). Merged over the
  // site-level defaults; omit on the home page to use the site meta as-is.
  meta?: PageMeta;
  // Present on entity/community/collection pages — the page knows the active
  // community server-side and threads it into the header/footer. Undefined
  // elsewhere.
  community?: CommunityRef;
  // Route params (e.g. { slug }) for the routing shim's useParams. Pathname and
  // search come from Astro.url; params are page-supplied. Threaded into the
  // header/footer islands' RouteProvider so route-dependent SSR matches
  // hydration.
  routeParams?: Record<string, string | undefined>;
  // Optional override; by default draft mode is read from the cookie here, since
  // it is a global toggle that must surface the banner + preview UI on every
  // page, not only entity pages that happen to thread it through.
  draftModeEnabled?: boolean;
}

const { meta, community, routeParams } = Astro.props;

const draftModeEnabled =
  Astro.props.draftModeEnabled ?? isDraftModeEnabled(Astro);

// Server-known route, seeded into the header/footer islands so pathname-dependent
// markup (e.g. the header's community-vs-home variant) renders identically on
// the server and after hydration.
const route = {
  pathname: Astro.url.pathname,
  search: Astro.url.search,
  params: routeParams ?? {},
};

const [themeRes, globalLayoutRes, globalStaticRes, siteMeta] =
  await Promise.all([
    query(LayoutThemeAstroQuery, {}),
    query(globalLayoutQuery, {}),
    query(globalStaticQuery, {}),
    getSiteMetadata(),
  ]);

const theme = themeRes.data?.globalConfiguration?.theme ?? undefined;
const themeClasses = getThemeClasses(theme);
const globalLayoutData = globalLayoutRes.data;
const globalData = globalStaticRes.data;
const head = resolvePageMeta(siteMeta, meta);
---

<html lang="en" dir="ltr" class={themeClasses}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <PageHead head={head} />
    <slot name="head" />
    {
      /* Google Charts loader (react-google-charts / analytics GeoChart + LineColChart).
       Declared statically in the shared head so it is a stable element across every
       page: ClientRouter keeps it across view-transition swaps instead of removing it.
       If react-google-charts injected loader.js itself, the swap would strip that
       runtime-added script while window.google persisted, so on the next visit it
       would inject a SECOND loader.js into a window that already has google —
       corrupting Google Charts ("gvjs_2d[a] is undefined"). Pre-declaring it means
       react-google-charts always finds it already loaded and reuses the one instance.
       onload sets data-loaded so react-google-charts takes its "already loaded" fast
       path (see node_modules/react-google-charts useLoadScript). */
    }
    <script
      is:inline
      src="https://www.gstatic.com/charts/loader.js"
      onload="this.dataset.loaded = '1'"></script>
    <ClientRouter />
  </head>
  <body>
    <LoadingBar />
    {draftModeEnabled && <DraftModeBannerIsland client:load />}
    <div class="app-shell">
      <AppHeader
        data={globalLayoutData}
        globalData={globalData}
        community={community}
        route={route}
      />
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <AppFooter
        data={globalLayoutData}
        globalData={globalData}
        community={community}
        route={route}
      />
    </div>
  </body>
</html>

<style>
  .app-shell {
    min-block-size: 100dvh;
    display: flex;
    flex-direction: column;
  }
</style>
