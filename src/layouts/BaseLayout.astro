---
// Phase 1: the outer root layout — the Astro port of app/[frontend]/layout.tsx
// + (pages)/layout.tsx. Owns <html>/<head>/<body>, the server-known theme
// classes, fonts + global CSS (prep step 2), the global chrome (header/footer
// islands), and a <slot/> for page content.
//
// The chrome is composed in Astro (AppHeader.astro / AppFooter.astro) around a
// plain Astro <slot/> — page content stays free to be its own server HTML +
// independent islands. Interactive chrome leaves are cache-safe islands
// (ChromeLeafProviders); per-viewer bits (account nav, footer admin/sign-in)
// render as `server:defer` islands that resolve the viewer per-request and opt
// out of the cache — so no viewer identity is serialized into cached page HTML.
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import { getThemeClasses } from "@/styles/theme-helpers";
import LoadingBar from "../components/client/LoadingBar.astro";
import query from "../lib/query";
import { isDraftModeEnabled } from "~/lib/request/draftMode";
import DraftModeBannerIsland from "../components/chrome/DraftModeBannerIsland";
import { LayoutThemeAstroQuery } from "../lib/queries/layout";
import { chromeLayoutQuery } from "../lib/chrome/queries";
import { query as globalStaticQuery } from "@/contexts/GlobalStaticContext/getStaticGlobalContextData.query";
import getSiteMetadata from "../lib/metadata/siteMetadata";
import resolvePageMeta from "../lib/metadata/resolvePageMeta";
import PageHead from "../components/head/PageHead.astro";
import AppHeader from "../components/global/AppHeader/AppHeader.astro";
import AppFooter from "../components/global/AppFooter/AppFooter.astro";
import type ChromeLeafProviders from "@/components/chrome/ChromeLeafProviders";
import type { ComponentProps } from "react";
import type { PageMeta } from "@/lib/metadata/types";

type CommunityRef = ComponentProps<typeof ChromeLeafProviders>["community"];

interface Props {
  // Page-level metadata (title, description, og:images…). Merged over the
  // site-level defaults; omit on the home page to use the site meta as-is.
  meta?: PageMeta;
  // Present on entity/community/collection pages — the page knows the active
  // community server-side and threads it into the chrome. Undefined elsewhere.
  community?: CommunityRef;
  // Route params (e.g. { slug }) for the routing shim's useParams. Pathname and
  // search come from Astro.url; params are page-supplied. Threaded into the
  // chrome islands' RouteProvider so route-dependent SSR matches hydration.
  routeParams?: Record<string, string | undefined>;
  // Optional override; by default draft mode is read from the cookie here, since
  // it is a global toggle that must surface the banner + preview chrome on every
  // page, not only entity pages that happen to thread it through.
  draftModeEnabled?: boolean;
}

const { meta, community, routeParams } = Astro.props;

const draftModeEnabled =
  Astro.props.draftModeEnabled ?? isDraftModeEnabled(Astro);

// Server-known route, seeded into the chrome islands so pathname-dependent
// markup (e.g. the header's community-vs-home variant) renders identically on
// the server and after hydration.
const route = {
  pathname: Astro.url.pathname,
  search: Astro.url.search,
  params: routeParams ?? {},
};

const [themeRes, chromeRes, globalStaticRes, siteMeta] = await Promise.all([
  query(LayoutThemeAstroQuery, {}),
  query(chromeLayoutQuery, {}),
  query(globalStaticQuery, {}),
  getSiteMetadata(),
]);

const theme = themeRes.data?.globalConfiguration?.theme ?? undefined;
const themeClasses = getThemeClasses(theme);
const chromeData = chromeRes.data;
const globalData = globalStaticRes.data;
const head = resolvePageMeta(siteMeta, meta);
---

<html lang="en" dir="ltr" class={themeClasses}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <PageHead head={head} />
    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    <LoadingBar />
    {draftModeEnabled && <DraftModeBannerIsland client:load />}
    <div class="app-shell">
      <AppHeader
        data={chromeData}
        globalData={globalData}
        community={community}
        route={route}
      />
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <AppFooter
        data={chromeData}
        globalData={globalData}
        community={community}
        route={route}
      />
    </div>
  </body>
</html>

<style>
  /* Ported from AppBody.module.css .content — footer sticks to the viewport
     bottom on short pages. */
  .app-shell {
    min-block-size: 100dvh;
    display: flex;
    flex-direction: column;
  }
</style>
