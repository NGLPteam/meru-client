---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import { getThemeClasses } from "@/styles/theme-helpers";
import LoadingBar from "../components/client/LoadingBar.astro";
import KeepScroll from "../components/client/KeepScroll.astro";
import TableOfContents from "../components/client/TableOfContents.astro";
import BackToTopBlock from "../components/client/BackToTopBlock.astro";
import CopyLink from "../components/client/CopyLink.astro";
import query from "../lib/query";
import { isDraftModeEnabled } from "~/lib/request/draftMode";
import DraftModeBanner from "../components/global/DraftModeBanner/DraftModeBanner.astro";
import { layoutThemeQuery, globalLayoutQuery } from "./graphql";
import { query as globalStaticQuery } from "@/contexts/GlobalStaticContext/getStaticGlobalContextData.query";
import getSiteMetadata from "../lib/metadata/siteMetadata";
import resolvePageMeta from "../lib/metadata/resolvePageMeta";
import PageHead from "../components/head/PageHead.astro";
import AppHeader from "../components/global/AppHeader/AppHeader.astro";
import AppFooter from "../components/global/AppFooter/AppFooter.astro";
import type { ActiveCommunityRef } from "@/components/global/graphql";
import type { PageMeta } from "@/lib/metadata/types";

interface Props {
  meta?: PageMeta;
  community?: ActiveCommunityRef;
  // Transitional — locals.pageSlug (attachRequestContext) is preferred; the
  // prop and its page-side threading retire in astroification Phase 5.
  routeParams?: Record<string, string | undefined>;
  // Optional override; by default draft mode is read from the cookie here
  draftModeEnabled?: boolean;
}

const { meta, community, routeParams } = Astro.props;

const draftModeEnabled =
  Astro.props.draftModeEnabled ?? isDraftModeEnabled(Astro);

const pageSlug = Astro.locals.pageSlug ?? routeParams?.page;

const [themeRes, globalLayoutRes, globalStaticRes, siteMeta] =
  await Promise.all([
    query(layoutThemeQuery, {}),
    query(globalLayoutQuery, {}),
    query(globalStaticQuery, {}),
    getSiteMetadata(),
  ]);

const theme = themeRes.data?.globalConfiguration?.theme ?? undefined;
const themeClasses = getThemeClasses(theme);
const globalLayoutData = globalLayoutRes.data;
const globalData = globalStaticRes.data;
const head = resolvePageMeta(siteMeta, meta);
---

<html lang="en" dir="ltr" class={themeClasses}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <PageHead head={head} />
    <slot name="head" />
    {
      /* Load Google Charts only once. Requires data-astro-transition-persist with view transitions. */
    }
    <script
      is:inline
      data-astro-transition-persist="google-charts-loader"
      src="https://www.gstatic.com/charts/loader.js"
      onload="this.dataset.loaded = '1'"></script>
    <ClientRouter />
  </head>
  <body>
    <LoadingBar />
    <KeepScroll />
    <TableOfContents />
    <BackToTopBlock />
    <CopyLink />
    {draftModeEnabled && <DraftModeBanner />}
    <div class="app-shell">
      <AppHeader
        data={globalLayoutData}
        globalData={globalData}
        community={community}
        pageSlug={pageSlug}
      />
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <AppFooter
        data={globalLayoutData}
        globalData={globalData}
        community={community}
      />
    </div>
  </body>
</html>

<style>
  .app-shell {
    min-block-size: 100dvh;
    display: flex;
    flex-direction: column;
  }
</style>
