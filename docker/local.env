NODE_ENV=production

PUBLIC_API_URL=http://host.docker.internal:6222/graphql

# Keycloak (server-only)
KEYCLOAK_CLIENT_ID=meru-public
KEYCLOAK_CLIENT_SECRET=12345secret
KEYCLOAK_REALM=meru
KEYCLOAK_URL=https://id.sandbox.meru.host

# Secret token for revalidation requests
REVALIDATE_SECRET=revalidatenow

REDIS_URL=redis://host.docker.internal:36379
REDIS_DB=2

# Canonical site origin for absolute URLs (sitemap/robots)
SITE_URL=http://localhost:14700

# Optional
SITEMAP_CACHE_MAXAGE=86400
SITEMAP_CACHE_REVALIDATE=59
