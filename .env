# API urls
PUBLIC_API_URL=https://api.sandbox.meru.host/graphql

# Keycloak (server-only)
KEYCLOAK_CLIENT_ID=meru-public
KEYCLOAK_CLIENT_SECRET=12345secret
KEYCLOAK_REALM=meru
KEYCLOAK_URL=https://id.sandbox.meru.host

# Secret token for revalidation requests
REVALIDATE_SECRET=

# Canonical site origin for absolute URLs (sitemap/robots); empty = request origin
SITE_URL=

# Optional
SITEMAP_CACHE_MAXAGE=86400
SITEMAP_CACHE_REVALIDATE=59

# Google Maps Key (public browser key)
PUBLIC_GOOGLE_MAPS_KEY=
